# Local development only. On GitHub Pages these are set as repository
# Variables (Settings → Secrets and variables → Actions → Variables).

# Supabase → Project Settings → API. The anon key is safe to publish.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the site. QR codes printed on guild cards point here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Venue timezone used to show and schedule sessions.
NEXT_PUBLIC_TIMEZONE=America/New_York

# Leave empty locally. GitHub Actions sets it to /everbound automatically.
NEXT_PUBLIC_BASE_PATH=

# Stripe keys and the service_role key are NEVER set here: they live only as
# Supabase Edge Function secrets (see docs/SETUP.md, step 5).
