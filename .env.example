# ---- Required: Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the site. QR codes printed on guild cards point here, so set it
# to your FINAL domain before printing cards (e.g. https://everbound.limelizardgames.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Venue timezone used to show and schedule sessions.
NEXT_PUBLIC_TIMEZONE=America/New_York

# ---- Required for Stripe payments (optional for the demo) ----
# Server-only. Never expose. Used by the Stripe webhook and checkout bookkeeping.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" once Stripe Tax is configured.
STRIPE_AUTOMATIC_TAX=false
